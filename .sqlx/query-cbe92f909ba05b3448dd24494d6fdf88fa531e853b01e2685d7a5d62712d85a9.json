  "query": "\n        SELECT media_id, file_ext, file_size, uploaded_at, content_type, original_file_name\n        FROM media\n        WHERE user_id = ?\n          AND (? IS NULL OR uploaded_at < ? OR (uploaded_at = ? AND media_id < ?))\n        ORDER BY uploaded_at DESC, media_id DESC\n        LIMIT ?\n        ",
