  "query": "\n        SELECT \n            media_id, file_ext, file_size, uploaded_at, content_type, original_file_name\n        FROM \n            media\n        WHERE \n            user_id = ?\n            AND (\n                ? IS NULL \n                OR uploaded_at < ? \n                OR (uploaded_at = ? AND media_id < ?)\n            )\n        ORDER BY \n            uploaded_at DESC, media_id DESC\n        LIMIT ?\n        ",
